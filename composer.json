{
    "name": "thebigcrafter/kygekeatheal",
    "description": "A PocketMine-MP plugin that lets players eat and heal themselves or others",
    "type": "pocketmine-plugin",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^2.1",
        "pocketmine/pocketmine-mp": "^5.0"
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "thebigcrafter\\Hydrogen\\": "tools/stubs/Hydrogen/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist"
    }
}
